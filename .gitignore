# Data is not committed. Everything under data/ is reproducible from scripts/,
# except the LLM label files and their item keys (data/labels), which cannot be re-pulled.
data/**
!data/
!data/*/
!data/**/.gitkeep
!data/labels/*.csv
!data/labels/*.md
!data/labels/*_key.parquet
# the sheets hold raw post text (tweets, Reddit), regenerated by 07 make with a fixed seed; not redistributed
data/labels/*sheet*.csv

__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env
.DS_Store
outputs/*
!outputs/.gitkeep
!outputs/figures/
!outputs/figures/*.png

# Our own working build log, not a graded deliverable, kept locally only
PROGRESS.md

# Class readings and slides, not ours to redistribute
Materials/
logs/
